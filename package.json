{
  "name": "meteo-workbench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "build:web": "tsc -b && VITE_ENABLE_MAP=false vite build",
    "preview": "vite preview",
    "preview:web": "npm run build:web && vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "ingest:at": "node scripts/at-ingest-stations.mjs",
    "ingest:at:normals": "node scripts/at-ingest-normals.mjs",
    "ingest:at:records": "node scripts/at-ingest-records.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uplot": "^1.6.32",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
