// Cloudflare-Worker der Seite (worker/index.ts): App aus dist/, Daten aus R2.
// Deployt von .github/workflows/deploy.yml (`wrangler deploy`), die Daten
// lädt scripts/upload-data.sh vorher in den Bucket.
{
  "name": "meteojunkie",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Pflicht für den Login (worker/auth.ts): sonst liefert Cloudflare die App-Dateien aus,
    // ohne den Worker zu fragen
    "run_worker_first": true
  },
  // Satelliten-Vorrat (alle 10 min) und Radar-Komposite (alle 5 min), dazu
  // im eigenen Lauf 2 min später das 3D-Radar, alle 10 min die TAWES-Werte — worker/index.ts → scheduled()
  "triggers": { "crons": ["*/5 * * * *", "2-59/5 * * * *", "7-59/10 * * * *"] },
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "meteojunkie-daten" }
  ],
  // Abrufprotokolle AUS: die Datenschutzerklärung sagt „kein Zugriff auf
  // Protokolldaten" (Impressum.tsx) — eingeschaltet speicherte Cloudflare
  // jede Anfrage einsehbar im Dashboard. Zur Fehlersuche kurz einschalten
  // und den Text dann anpassen, nicht umgekehrt.
  "observability": { "enabled": false }
}
