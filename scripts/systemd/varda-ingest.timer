# Läufe 06 und 18 UTC: die MeteoSwiss-Analyse erscheint 2–2¾ h nach dem
# Termin, gestartet wird mit Reserve 3¼ h danach. Persistent: war der Laptop
# zur Startzeit aus, läuft es beim nächsten Einschalten nach (und nimmt dann
# den jüngsten verfügbaren Lauf).
[Unit]
Description=Varda-Modellkarten zweimal täglich

[Timer]
OnCalendar=*-*-* 09:15:00 UTC
OnCalendar=*-*-* 21:15:00 UTC
Persistent=true
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
